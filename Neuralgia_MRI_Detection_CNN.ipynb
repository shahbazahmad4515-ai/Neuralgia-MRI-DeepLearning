        "from tensorflow.keras.applications import VGG16\n",
        "from sklearn.utils import class_weight\n",
        "import numpy as np\n",
        "\n",
        "# 1. Calculate Class Weights to handle the 4 vs 33 imbalance\n",
        "weights = class_weight.compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=np.unique(y_train),\n",
        "    y=y_train\n",
        ")\n",
        "weight_dict = {0: weights[0], 1: weights[1]}\n",
        "print(f\"Applying Class Weights: {weight_dict}\")\n",
        "\n",
        "# 2. Build the Model (Transfer Learning)\n",
        "base_model = VGG16(weights='imagenet', include_top=False, input_shape=(128, 128, 3))\n",
        "base_model.trainable = True # Set to True for fine-tuning on medical data\n",
        "\n",
        "model = models.Sequential([\n",
        "    base_model,\n",
        "    layers.GlobalAveragePooling2D(),\n",
        "    layers.Dense(256, activation='relu'),\n",
        "    layers.Dropout(0.5),\n",
        "    layers.Dense(1, activation='sigmoid')\n",
        "])\n",
        "\n",
        "model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=1e-5),\n",
        "              loss='binary_crossentropy', metrics=['accuracy'])\n",
        "\n",
        "# 3. Train\n",
        "print(\"\\n🚀 Training Medical AI...\")\n",
        "history = model.fit(X_train, y_train,\n",
        "                    epochs=30,\n",
        "                    validation_data=(X_test, y_test),\n",
        "                    class_weight=weight_dict,\n",
        "                    batch_size=16)"
