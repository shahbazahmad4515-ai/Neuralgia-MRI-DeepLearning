      "cell_type": "code",
      "source": [
        "import os, glob, nibabel as nib, numpy as np, pandas as pd, cv2, tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "from tensorflow.keras import layers, models\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# --- 1. SET PATHS ---\n",
        "participants_file = '/content/participants.tsv'\n",
        "dataset_root = '/content/dataset'\n",
        "\n",
        "# --- 2. LOAD TSV (Handling 14 vs 41 columns) ---\n",
        "with open(participants_file, 'r') as f:\n",
        "    lines = f.readlines()\n",
        "max_cols = max([len(l.split('\\t')) for l in lines])\n",
        "df = pd.read_csv(participants_file, sep='\\t', names=range(max_cols), low_memory=False)\n",
        "df.columns = df.iloc[0].tolist()\n",
        "df = df[1:].reset_index(drop=True)\n",
        "df.columns = df.columns.str.strip()\n",
        "\n",
        "# --- 3. MAP SUBJECTS TO MRI FILES ---\n",
        "print(\"🔍 Mapping subjects to MRI files...\")\n",
        "all_mri_files = glob.glob(os.path.join(dataset_root, '**/*.nii.gz'), recursive=True)\n",
        "# We prioritize 'anat' files for structural diagnosis\n",
        "structural_files = [f for f in all_mri_files if 'anat' in f or 'T1w' in f or 'T2w' in f]\n",
        "\n",
        "data_map = {}\n",
        "for f_path in structural_files:\n",
        "    parts = f_path.split('/')\n",
        "    sub_id = next((p for p in parts if p.startswith('sub-')), None)\n",
        "    if sub_id:\n",
        "        if sub_id not in data_map: data_map[sub_id] = []\n",
        "        data_map[sub_id].append(f_path)\n",
        "\n",
        "valid_subject_ids = list(data_map.keys())\n",
        "healthy_ids = [s for s in valid_subject_ids if len(s.replace('fu','')) <= 6]\n",
        "neuralgia_ids = [s for s in valid_subject_ids if len(s.replace('fu','')) > 6]\n",
        "\n",
        "print(f\"✅ Found {len(healthy_ids)} Healthy and {len(neuralgia_ids)} Neuralgia subjects.\")\n",
        "\n",
        "# --- 4. NERVE-FOCUS EXTRACTION ---\n",
        "def extract_final_data(id_list):\n",
        "    x, y = [], []\n",
        "    for sub_id in id_list:\n",
        "        clean_id = sub_id.replace('fu', '')\n",
        "        row = df.loc[df.iloc[:,0] == clean_id]\n",
        "\n",
        "        # Labeling: 0 = Healthy, 1 = Neuralgia\n",
        "        if not row.empty:\n",
        "            finding = str(row.get('Clinical_finding', row.iloc[:, 4]).iloc[0])\n",
        "            label = 1 if 'TN' in finding else 0\n",
        "        else:\n",
        "            label = 0 if len(clean_id) <= 6 else 1\n",
        "\n",
        "        # Balancing: More slices for Healthy subjects\n",
        "        num_slices = 25 if label == 0 else 8\n",
        "        best_mri = max(data_map[sub_id], key=os.path.getsize)\n",
        "\n",
        "        try:\n",
        "            data = nib.load(best_mri).get_fdata()\n",
        "            mid = data.shape[2] // 2\n",
        "            for i in range(mid - num_slices, mid + num_slices):\n",
        "                slice_data = data[:, :, i, 0] if len(data.shape) == 4 else data[:, :, i]\n",
        "                # --- NERVE CROP (ROI) ---\n",
        "                h, w = slice_data.shape\n",
        "                crop = slice_data[h//4:3*h//4, w//4:3*w//4]\n",
        "                s = cv2.resize(crop, (128, 128))\n",
        "                s = (s - np.min(s)) / (np.max(s) - np.min(s) + 1e-8)\n",
        "                x.append(s)\n",
        "                y.append(label)\n",
        "        except: continue\n",
        "        print(f\"Loaded {sub_id}...\", end=\"\\r\")\n",
        "    return np.array(x), np.array(y)\n",
        "\n",
        "# Split and Execute\n",
        "train_ids, test_ids = train_test_split(valid_subject_ids, test_size=0.2, random_state=42)\n",
        "X_train_raw, y_train = extract_final_data(train_ids)\n",
        "X_test_raw, y_test = extract_final_data(test_ids)\n",
        "\n",
        "# --- 5. PREPARE FOR CNN ---\n",
        "X_train = np.repeat(X_train_raw[..., np.newaxis], 3, axis=-1)\n",
        "X_test = np.repeat(X_test_raw[..., np.newaxis], 3, axis=-1)\n",
        "\n",
        "print(f\"\\n\\n🚀 FINAL SUCCESS! Train Slices: {len(X_train)} | Test Slices: {len(X_test)}\")"
